<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="Reporte_Insumos" language="groovy"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20"
              uuid="b1234567-89ab-cdef-0123-456789abcdef">

    <!-- Estilos -->
    <style name="Title" forecolor="#FFFFFF" fontName="Times New Roman" fontSize="50" pdfFontName="Times-Bold"/>
    <style name="SubTitle" forecolor="#CCCCCC" fontName="Times New Roman" fontSize="18" pdfFontName="Times-Roman"/>
    <style name="Column header" forecolor="#666666" fontName="Times New Roman" fontSize="14" isBold="true"/>
    <style name="Detail" mode="Transparent" fontName="Times New Roman"/>
    <style name="Row" mode="Transparent" fontName="Times New Roman">
        <conditionalStyle>
            <conditionExpression><![CDATA[$V{REPORT_COUNT}%2 == 0]]></conditionExpression>
            <style mode="Opaque" backcolor="#F0EFEF"/>
        </conditionalStyle>
    </style>

    <!-- Query -->
    <queryString language="SQL">
        <![CDATA[SELECT * FROM insumos]]>
    </queryString>

    <!-- Campos -->
    <field name="id_ins" class="java.lang.Integer"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Double"/>
    <field name="unidad_medida" class="java.lang.String"/>
    <field name="stock_min" class="java.lang.Double"/>

    <!-- Título -->
    <title>
        <band height="80">
            <frame>
                <reportElement mode="Opaque" x="0" y="0" width="802" height="60" backcolor="#000000"/>
                <staticText>
                    <reportElement style="Title" x="0" y="0" width="400" height="60"/>
                    <text><![CDATA[PAE]]></text>
                </staticText>
                <staticText>
                    <reportElement style="SubTitle" x="400" y="20" width="400" height="40"/>
                    <textElement textAlignment="Right">
                        <font size="22"/>
                    </textElement>
                    <text><![CDATA[Reporte Insumos]]></text>
                </staticText>
            </frame>
        </band>
    </title>

    <!-- Encabezado de columnas -->
    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement style="Column header" x="0" y="0" width="80" height="20"/>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement style="Column header" x="80" y="0" width="200" height="20"/>
                <text><![CDATA[Nombre]]></text>
            </staticText>
            <staticText>
                <reportElement style="Column header" x="280" y="0" width="120" height="20"/>
                <text><![CDATA[Cantidad]]></text>
            </staticText>
            <staticText>
                <reportElement style="Column header" x="400" y="0" width="150" height="20"/>
                <text><![CDATA[Unidad de Medida]]></text>
            </staticText>
            <staticText>
                <reportElement style="Column header" x="550" y="0" width="120" height="20"/>
                <text><![CDATA[Stock Mínimo]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- Detalle -->
    <detail>
        <band height="20">
            <frame>
                <reportElement style="Row" x="0" y="0" width="802" height="20"/>
                <textField>
                    <reportElement style="Detail" x="0" y="0" width="80" height="20"/>
                    <textFieldExpression><![CDATA[$F{id_ins}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Detail" x="80" y="0" width="200" height="20"/>
                    <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Detail" x="280" y="0" width="120" height="20"/>
                    <textFieldExpression><![CDATA[$F{cantidad}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Detail" x="400" y="0" width="150" height="20"/>
                    <textFieldExpression><![CDATA[$F{unidad_medida}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Detail" x="550" y="0" width="120" height="20"/>
                    <textFieldExpression><![CDATA[$F{stock_min}]]></textFieldExpression>
                </textField>
            </frame>
        </band>
    </detail>

    <!-- Pie de página -->
    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="700" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
